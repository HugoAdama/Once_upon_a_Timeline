---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import CandyJukebox from '../components/CandyJukebox.astro';
import VirtualCandybong from '../components/VirtualCandybong.astro';
import FluidBackground from '../components/FluidBackground.astro';
import { resolveAsset } from '../utils/streaming';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Once Upon a Timeline — TWICE Fan Archive',
  description = 'Once Upon a Timeline: archivo interactivo de TWICE, sus 9 integrantes, discografía completa en Corea, Japón y global, eras musicales y colecciones de personajes LOVELYS y TDOONGZ.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hugoadama.github.io/Once_upon_a_Timeline/');
const faviconSrc = resolveAsset('/favicon.svg');
const manifestSrc = resolveAsset('/manifest.webmanifest');
const ogImageURL = new URL(resolveAsset('/assets/og-banner.png') || '/assets/og-banner.png', Astro.site || 'https://hugoadama.github.io/Once_upon_a_Timeline/').href;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MusicGroup',
      '@id': 'https://twice.jype.com/#musicgroup',
      name: 'TWICE',
      alternateName: ['트와이스', 'トゥワイス'],
      description: description,
      genre: ['K-pop', 'J-pop', 'Dance-pop'],
      foundingDate: '2015-10-20',
      sameAs: [
        'https://twice.jype.com/',
        'https://www.twicejapan.com/',
        'https://www.youtube.com/@TWICE',
        'https://www.instagram.com/twicetagram/',
        'https://twitter.com/jypetwice',
        'https://open.spotify.com/artist/7n2YcHowBYUVNC92s2bLdu',
      ],
      member: [
        { '@type': 'Person', name: 'Nayeon', alternateName: 'Im Na-yeon' },
        { '@type': 'Person', name: 'Jeongyeon', alternateName: 'Yoo Jeong-yeon' },
        { '@type': 'Person', name: 'Momo', alternateName: 'Hirai Momo' },
        { '@type': 'Person', name: 'Sana', alternateName: 'Minatozaki Sana' },
        { '@type': 'Person', name: 'Jihyo', alternateName: 'Park Ji-hyo' },
        { '@type': 'Person', name: 'Mina', alternateName: 'Myoui Mina' },
        { '@type': 'Person', name: 'Dahyun', alternateName: 'Kim Da-hyun' },
        { '@type': 'Person', name: 'Chaeyoung', alternateName: 'Son Chae-young' },
        { '@type': 'Person', name: 'Tzuyu', alternateName: 'Chou Tzu-yu' },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL.origin}/#website`,
      url: canonicalURL.href,
      name: 'Once Upon a Timeline',
      description: description,
      inLanguage: 'es',
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fff8f3" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Preconnect para Google Fonts (Optimización FCP / LCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=Outfit:wght@400;500;600;700;800&display=swap"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Once Upon a Timeline — TWICE Fan Archive" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Once Upon a Timeline — TWICE Fan Archive" />

    <link rel="icon" type="image/svg+xml" href={faviconSrc} />
    <link rel="apple-touch-icon" href={faviconSrc} />
    <link rel="manifest" href={manifestSrc} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Once Timeline" />
    <title>{title}</title>

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <FluidBackground />
    <div class="scroll-progress-bar" aria-hidden="true"></div>
    <a href="#main-content" class="skip-to-content">Saltar al contenido principal</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <CandyJukebox />
    <VirtualCandybong />

    <script>
      import { initScrollReveals } from '../scripts/scroll-reveal';
      import { initVirtualCandybong } from '../scripts/virtual-candybong';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initScrollReveals();
          initVirtualCandybong();
        });
      } else {
        initScrollReveals();
        initVirtualCandybong();
      }

      // Registro seguro de PWA Service Worker
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('./sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
