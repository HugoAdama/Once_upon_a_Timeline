---
import { KILLING_PARTS } from '../data/killing-parts';
---

<div class="killing-parts-bar" aria-label="Killing Parts icónicas de TWICE">
  <span class="killing-parts-label">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
    </svg>
    <span>Killing Parts:</span>
  </span>

  <div class="killing-parts-scroll">
    {KILLING_PARTS.map((kp) => (
      <button
        type="button"
        class="killing-part-chip"
        data-killing-query={kp.searchQuery}
        data-killing-song={kp.song}
        title={`${kp.phrase} · ${kp.member} (${kp.song}) — ${kp.note}`}
      >
        <span class="kp-quote">"{kp.phrase}"</span>
        <span class="kp-meta">· {kp.member}</span>
      </button>
    ))}
  </div>
</div>
