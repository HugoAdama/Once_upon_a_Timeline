---
import { KILLING_PARTS } from '../data/killing-parts';
---

<div class="killing-parts-bar" aria-label="Killing Parts icónicas de TWICE">
  <div class="killing-parts-scroll">
    {KILLING_PARTS.map((kp) => (
      <button
        type="button"
        class="killing-part-chip"
        data-killing-query={kp.searchQuery}
        data-killing-song={kp.song}
        title={`${kp.phrase} · ${kp.member} (${kp.song}) — ${kp.note}`}
      >
        <span class="kp-quote">"{kp.phrase}"</span>
        <span class="kp-meta">· {kp.member}</span>
      </button>
    ))}
  </div>
</div>
