---
import QuizCard from './QuizCard.astro';
import PhotocardStudio from './PhotocardStudio.astro';
---

<section class="section wrap fan-zone-section" id="fan-zone">
  <div class="section-heading">
    <div>
      <span class="eyebrow">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span>08 · Espacio Interactivo de la Comunidad</span>
      </span>
      <h2>ONCE Fan Zone.</h2>
    </div>
    <p>
      El espacio interactivo para la comunidad ONCE: descubre qué integrante de TWICE coincide con tu personalidad y personaliza tu propia photocard de coleccionista.
    </p>
  </div>

  <div class="fan-zone-grid">
    <QuizCard />
    <PhotocardStudio />
  </div>
</section>

<script>
  import { initFanZone } from '../scripts/fan-zone';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFanZone);
  } else {
    initFanZone();
  }
</script>
