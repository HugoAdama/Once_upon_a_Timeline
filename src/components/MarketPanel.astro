---
import type { Market } from '../types';
import type { YearGroup } from '../utils/releases';
import ReleaseItem from './ReleaseItem.astro';

interface Props {
  marketKey: Market;
  kicker: string;
  title: string;
  description: string;
  groups: YearGroup[];
  totalReleases: number;
  defaultOpen?: boolean;
}

const { marketKey, kicker, title, description, groups, totalReleases, defaultOpen = false } = Astro.props;
---

<details class="release-market scroll-reveal" open={defaultOpen} data-market-panel={marketKey}>
  <summary>
    <span class="market-heading">
      <span class="market-kicker" data-i18n={marketKey === 'korea' ? 'disco.kickerKorea' : marketKey === 'japan' ? 'disco.kickerJapan' : 'disco.kickerGlobal'}>{kicker}</span>
      <strong data-i18n={marketKey === 'korea' ? 'disco.marketKorea' : marketKey === 'japan' ? 'disco.marketJapan' : 'disco.marketGlobal'}>{title}</strong>
      <small data-i18n={marketKey === 'korea' ? 'disco.koreaDesc' : marketKey === 'japan' ? 'disco.japanDesc' : 'disco.globalDesc'}>{description}</small>
    </span>
    <span class="market-count" {...{ [`data-market-count-${marketKey}`]: true }}>
      {totalReleases} <span data-i18n="disco.marketCount">registros</span>
    </span>
  </summary>
  <div class="release-years">
    {groups.map((group) => (
      <section class="release-year" data-year-section={group.year}>
        <h3>
          {group.year}
          <small>{group.releases.length} <span data-i18n={group.releases.length === 1 ? 'disco.releaseCountSingular' : 'disco.releaseCountPlural'}>{group.releases.length === 1 ? 'lanzamiento' : 'lanzamientos'}</span></small>
        </h3>
        <ul class="release-list">
          {group.releases.map((release) => (
            <ReleaseItem release={release} />
          ))}
        </ul>
      </section>
    ))}
  </div>
</details>
