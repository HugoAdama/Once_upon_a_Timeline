---
import type { Market } from '../types';
import type { YearGroup } from '../utils/releases';
import ReleaseItem from './ReleaseItem.astro';

interface Props {
  marketKey: Market;
  kicker: string;
  title: string;
  description: string;
  groups: YearGroup[];
  totalReleases: number;
  defaultOpen?: boolean;
}

const { marketKey, kicker, title, description, groups, totalReleases, defaultOpen = false } = Astro.props;
---

<details class="release-market scroll-reveal" open={defaultOpen} data-market-panel={marketKey}>
  <summary>
    <span class="market-heading">
      <span class="market-kicker" data-i18n={marketKey === 'korea' ? 'market.kickerKorea' : marketKey === 'japan' ? 'market.kickerJapan' : 'market.kickerGlobal'}>{kicker}</span>
      <strong data-i18n={marketKey === 'korea' ? 'market.titleKorea' : marketKey === 'japan' ? 'market.titleJapan' : 'market.titleGlobal'}>{title}</strong>
      <small data-i18n={marketKey === 'korea' ? 'market.descKorea' : marketKey === 'japan' ? 'market.descJapan' : 'market.descGlobal'}>{description}</small>
    </span>
    <span class="market-count" data-market-panel-count={marketKey} data-count={totalReleases} {...{ [`data-market-count-${marketKey}`]: true }}>
      {totalReleases} registros
    </span>
  </summary>
  <div class="release-years">
    {groups.map((group) => (
      <section class="release-year" data-year-section={group.year}>
        <h3>
          {group.year}
          <small><span data-year-release-count={group.releases.length}>{group.releases.length} {group.releases.length === 1 ? 'lanzamiento' : 'lanzamientos'}</span></small>
        </h3>
        <ul class="release-list">
          {group.releases.map((release) => (
            <ReleaseItem release={release} />
          ))}
        </ul>
      </section>
    ))}
  </div>
</details>
