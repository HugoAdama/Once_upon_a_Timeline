---
/**
 * Candy Jukebox — ONCE Interactive Mini Player
 * Mini reproductor de sintetizador web con visualizador de espectro para TWICE
 */
import { resolveAsset } from '../utils/streaming';
import CandyJukeboxLauncher from './CandyJukeboxLauncher.astro';
import CandyJukeboxPlaylist from './CandyJukeboxPlaylist.astro';
import CandyJukeboxControls from './CandyJukeboxControls.astro';

const initialCoverSrc = resolveAsset('/assets/covers/feel-special.webp') || '/assets/covers/feel-special.webp';
---

<div id="candy-jukebox" class="candy-jukebox-container" aria-label="Reproductor Candy Jukebox">
  <!-- Launcher Button -->
  <CandyJukeboxLauncher />

  <!-- Expanded Card Player -->
  <div id="jukebox-card" class="jukebox-card" role="region" aria-label="Controles de audio Candy Jukebox">
    <div class="jukebox-header">
      <div class="jukebox-header-title">
        <svg class="jukebox-music-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
        <span>Candy Jukebox</span>
      </div>
      <div class="jukebox-header-actions">
        <span id="jukebox-track-counter" class="jukebox-track-counter" aria-label="Número de pista actual">1 / 6</span>
        <button id="jukebox-minimize" class="jukebox-action-btn" type="button" aria-label="Minimizar a barra compacta" title="Minimizar a barra compacta">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 14 10 14 10 20"/>
            <polyline points="20 10 14 10 14 4"/>
          </svg>
        </button>
        <button id="jukebox-close" class="jukebox-close-btn" type="button" aria-label="Cerrar reproductor">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="jukebox-track-body">
      <div class="jukebox-track-meta">
        <div id="jukebox-art-cover" class="jukebox-art-cover" aria-hidden="true">
          <img
            id="jukebox-art-img"
            src={initialCoverSrc}
            alt="Portada oficial del tema en reproducción"
            class="jukebox-art-img"
            width="56"
            height="56"
            loading="lazy"
          />
        </div>
        <div class="jukebox-track-details">
          <h4 id="jukebox-track-name" class="jukebox-track-name">Feel Special</h4>
          <p id="jukebox-track-era" class="jukebox-track-era">Feel Special (2019)</p>
          <span class="jukebox-track-badge">Clip Oficial · 30s</span>
        </div>
      </div>

      <!-- Canvas Visualizer -->
      <div class="jukebox-visualizer-wrap">
        <canvas id="jukebox-canvas" width="294" height="38" aria-label="Visualizador espectral de audio"></canvas>
      </div>

      <!-- Seekable Progress Bar -->
      <div class="jukebox-progress-wrap">
        <div
          id="jukebox-progress-track"
          class="jukebox-progress-track"
          role="slider"
          aria-label="Progreso de la pista"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          tabindex="0"
        >
          <div id="jukebox-progress-fill" class="jukebox-progress-fill" style="width: 0%;"></div>
        </div>
        <div class="jukebox-progress-times">
          <span id="jukebox-current-time">0:00</span>
          <span id="jukebox-duration">0:30</span>
        </div>
      </div>
    </div>

    <!-- Playlist Track Selector (2-Column Grid) -->
    <CandyJukeboxPlaylist />

    <!-- Elemento de audio nativo para pistas oficiales reales -->
    <audio id="jukebox-audio-element" preload="none" style="display:none;"></audio>

    <!-- Controls -->
    <CandyJukeboxControls />
  </div>
</div>

<script>
  import { initCandyJukebox } from '../scripts/candy-jukebox';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCandyJukebox);
  } else {
    initCandyJukebox();
  }
</script>
