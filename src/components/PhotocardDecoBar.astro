---
// Barra de herramientas de Polco Deco para Photocard Studio
---

<div class="deco-toolbar" id="photocard-deco-toolbar">
  <!-- Holo Finish Selector -->
  <div class="control-field">
    <span class="control-label">Acabado Holográfico:</span>
    <div class="deco-holo-row" role="radiogroup" aria-label="Acabado holográfico">
      <button type="button" class="deco-pill active" data-holo-finish="none" role="radio" aria-checked="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
        </svg>
        <span>Liso</span>
      </button>

      <button type="button" class="deco-pill" data-holo-finish="glitter" role="radio" aria-checked="false">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        <span>Holo Glitter</span>
      </button>

      <button type="button" class="deco-pill" data-holo-finish="prism" role="radio" aria-checked="false">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 2 22 22 22 12 2"/>
        </svg>
        <span>Prisma Arcoíris</span>
      </button>
    </div>
  </div>

  <!-- Stickers Deco (Polco Stickers) -->
  <div class="control-field">
    <span class="control-label">Stickers Polco Deco:</span>
    <div class="deco-stickers-row" aria-label="Stickers decorativos">
      <button type="button" class="deco-sticker-btn" data-sticker="washi" title="Cintas Washi Tape decorativas" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="7" width="20" height="10" rx="2"/>
          <line x1="7" y1="7" x2="7" y2="17"/>
          <line x1="17" y1="7" x2="17" y2="17"/>
        </svg>
        <span>Washi Tape</span>
      </button>

      <button type="button" class="deco-sticker-btn" data-sticker="anniversary" title="Sello dorado 10th Aniversario" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="6"/>
          <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
        </svg>
        <span>10th Seal</span>
      </button>

      <button type="button" class="deco-sticker-btn" data-sticker="candybong" title="Insignia destello Candybong" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
        </svg>
        <span>Candybong</span>
      </button>

      <button type="button" class="deco-sticker-btn" data-sticker="sparkles" title="Constelación de destellos ONCE" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
        <span>Destellos</span>
      </button>
    </div>
  </div>
</div>
