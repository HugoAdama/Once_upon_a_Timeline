---
import { MEMBERS } from '../data/members';
import { resolveAsset } from '../utils/streaming';
import PhotocardDecoBar from './PhotocardDecoBar.astro';

const initialPhoto = resolveAsset(MEMBERS[0].photo);
---

<div class="customizer-card scroll-reveal" id="photocard-studio-card">
  <div class="customizer-header">
    <div class="customizer-title-row">
      <h3 class="customizer-title">Photocard Studio &amp; Polco Deco</h3>
      <span class="studio-sync-pill" id="studio-sync-pill" style="display: none;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span id="studio-sync-pill-text">Afinidad Sincronizada</span>
      </span>
    </div>
    <p class="customizer-subtitle">Diseña tu photocard oficial de colección con stickers Polco Deco, acabados holográficos y descarga en PNG de alta resolución (600x900px).</p>
  </div>

  <div class="customizer-workspace">
    <!-- Vista previa interactiva de la tarjeta con capas Polco Deco -->
    <div class="photocard-canvas-wrap" id="photocard-canvas-preview">
      <img
        src={initialPhoto}
        id="canvas-member-photo"
        class="canvas-member-photo"
        alt="Photocard de integrante"
      />
      <div class="canvas-photo-vignette" aria-hidden="true"></div>
      <span class="canvas-sheen" aria-hidden="true"></span>
      <div class="canvas-holo-overlay" id="canvas-holo-overlay" aria-hidden="true"></div>

      <!-- Washi Tape decorative accents -->
      <div class="canvas-washi washi-top-left" id="washi-strip-top" aria-hidden="true" style="display: none;"></div>
      <div class="canvas-washi washi-bottom-right" id="washi-strip-bottom" aria-hidden="true" style="display: none;"></div>

      <!-- Polco Deco Stickers Layer -->
      <div class="canvas-stickers-layer" id="canvas-stickers-layer" aria-hidden="true">
        <div class="canvas-sticker sticker-anniversary" id="sticker-anniversary" style="display: none;">
          <svg width="38" height="38" viewBox="0 0 40 40" fill="none">
            <circle cx="20" cy="20" r="18" fill="rgba(245, 166, 35, 0.2)" stroke="#f5a623" stroke-width="2"/>
            <circle cx="20" cy="20" r="14" stroke="#f5a623" stroke-width="1" stroke-dasharray="2 2"/>
            <text x="20" y="24" text-anchor="middle" font-size="10" font-weight="bold" fill="#fff">10TH</text>
          </svg>
        </div>
        <div class="canvas-sticker sticker-candybong" id="sticker-candybong" style="display: none;">
          <svg width="34" height="34" viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="14" r="10" fill="#ff7399" opacity="0.8"/>
            <circle cx="16" cy="14" r="6" fill="#fff"/>
            <circle cx="16" cy="14" r="3" fill="#ff7399"/>
            <rect x="14" y="22" width="4" height="8" rx="2" fill="#ffffff"/>
          </svg>
        </div>
        <div class="canvas-sticker sticker-sparkles" id="sticker-sparkles" style="display: none;">
          <span class="sparkle-point sp-1">✦</span>
          <span class="sparkle-point sp-2">★</span>
          <span class="sparkle-point sp-3">✧</span>
        </div>
      </div>

      <span class="canvas-top-tag">ONCE ARCHIVE · 10TH</span>
      <span class="canvas-match-tag" id="canvas-match-tag" style="display: none;">MATCH OFICIAL · TEST DE IDENTIDAD</span>

      <div class="canvas-member-seal">
        <span class="canvas-member-name" id="canvas-member-preview">Nayeon</span>
        <span class="canvas-fan-name" id="canvas-fan-preview">ONCE Oficial</span>
      </div>

      <div class="canvas-footer">
        <span>COLLECTOR EDITION</span>
        <span>2015 — 2026</span>
      </div>
    </div>

    <!-- Controles de personalización -->
    <div class="customizer-controls">
      <div class="control-field">
        <label for="custom-fan-name" class="control-label">Tu Nombre o Alias de Fan:</label>
        <input
          type="text"
          id="custom-fan-name"
          class="control-input"
          placeholder="Escribe tu nombre..."
          maxlength="20"
          value="ONCE Oficial"
        />
      </div>

      <div class="control-field">
        <label for="custom-member-select" class="control-label">Tu Bias / Integrante:</label>
        <select id="custom-member-select" class="control-select">
          {MEMBERS.map((m) => (
            <option
              value={m.name}
              data-photo={resolveAsset(m.photo)}
              data-color={m.colorHex}
              data-id={m.name.toLowerCase()}
            >
              {m.name} ({m.role})
            </option>
          ))}
        </select>
      </div>

      <div class="control-field">
        <span class="control-label">Color del Marco Holográfico:</span>
        <div class="color-picker-row">
          <button type="button" class="palette-btn active" data-frame-color="#e83e86" style="--c: #e83e86;" title="Neon Magenta" aria-label="Neon Magenta"></button>
          <button type="button" class="palette-btn" data-frame-color="#f4a27e" style="--c: #f4a27e;" title="Apricot" aria-label="Apricot"></button>
          <button type="button" class="palette-btn" data-frame-color="#5bc2e7" style="--c: #5bc2e7;" title="Sky Blue" aria-label="Sky Blue"></button>
          <button type="button" class="palette-btn" data-frame-color="#bdd36c" style="--c: #bdd36c;" title="Lime Green" aria-label="Lime Green"></button>
          <button type="button" class="palette-btn" data-frame-color="#ff6ea7" style="--c: #ff6ea7;" title="Pink" aria-label="Pink"></button>
          <button type="button" class="palette-btn" data-frame-color="#b9a0df" style="--c: #b9a0df;" title="Purple" aria-label="Purple"></button>
          <button type="button" class="palette-btn" data-frame-color="#91d1c1" style="--c: #91d1c1;" title="Mint" aria-label="Mint"></button>
          <button type="button" class="palette-btn" data-frame-color="#e02438" style="--c: #e02438;" title="Red" aria-label="Red"></button>
          <button type="button" class="palette-btn" data-frame-color="#005bac" style="--c: #005bac;" title="Navy Blue" aria-label="Navy Blue"></button>
        </div>
      </div>

      <!-- Barra de herramientas Polco Deco -->
      <PhotocardDecoBar />

      <button type="button" class="download-photocard-btn" id="download-photocard-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Descargar Photocard (PNG)</span>
      </button>
    </div>
  </div>
</div>
