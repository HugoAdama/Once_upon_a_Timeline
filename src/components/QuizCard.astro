---
import { FAN_QUIZ_QUESTIONS } from '../data/fan-zone';
---

<div class="quiz-card scroll-reveal">
  <div class="quiz-header">
    <span class="quiz-kicker" data-i18n="quiz.kicker">Test de Identidad</span>
    <span class="quiz-progress-pill" id="quiz-counter-text">1 / {FAN_QUIZ_QUESTIONS.length}</span>
  </div>

  <div class="quiz-progress-bar" aria-hidden="true">
    <div class="quiz-progress-fill" id="quiz-progress-fill"></div>
  </div>

  <div id="quiz-body">
    {FAN_QUIZ_QUESTIONS.map((q, idx) => (
      <div class="quiz-question-step" style={idx === 0 ? '' : 'display: none;'}>
        <h3 class="quiz-prompt">{q.prompt}</h3>
        <div class="quiz-options-list">
          {q.options.map((opt, optIdx) => (
            <button
              type="button"
              class="quiz-option-btn"
              data-quiz-choice={opt.memberId}
            >
              <span class="option-bullet" aria-hidden="true">{String.fromCharCode(65 + optIdx)}</span>
              <span>{opt.text}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Vista de Resultados del Quiz -->
  <div class="quiz-result-view" id="quiz-result-view">
    <span class="quiz-result-badge" data-i18n="quiz.resultBadge">Afinidad ONCE Detectada</span>
    <h3 class="quiz-result-title" id="result-member-title">Tu esencia</h3>
    <p class="quiz-result-desc" id="result-member-desc">Cargando afinidad...</p>

    <div class="quiz-result-bridge-box">
      <div class="quiz-sync-status">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span id="quiz-sync-status-text" data-i18n="quiz.syncStatusText">Tu afinidad se sincronizo con el Photocard Studio</span>
      </div>
      <div class="quiz-result-actions">
        <button type="button" class="quiz-apply-btn" id="quiz-apply-studio-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          <span id="quiz-apply-btn-label" data-i18n="quiz.applyStudio">Personalizar mi Photocard</span>
        </button>
        <button type="button" class="quiz-reset-btn" id="quiz-reset-btn" data-i18n="quiz.repeat">
          Repetir Test
        </button>
      </div>
    </div>
  </div>
</div>
