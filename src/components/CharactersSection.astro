---
import { LOVELYS, TDOONGZ } from '../data/characters';
import CharacterTile from './CharacterTile.astro';
---

<section class="section characters-section" id="personajes">
  <div class="wrap">
    <div class="section-heading scroll-reveal">
      <div>
        <span class="eyebrow" data-i18n="characters.eyebrow">02 · Personajes</span>
        <h2 data-i18n="characters.title">Dos colecciones, un mismo universo.</h2>
      </div>
      <p data-i18n="characters.desc">
        Descubre a las mascotas oficiales de TWICE: los entrañables Lovelys y la divertida colección TDOONGZ de Dream Attic. Explora cada personaje para conocer su personalidad y a la integrante que representa.
      </p>
    </div>

    <!-- Selector interactivo de colección / universo -->
    <div class="characters-filter-bar scroll-reveal" role="tablist" aria-label="Filtrar por colección de personajes">
      <span class="char-filter-label">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 2 7 12 12 22 7 12 2"/>
          <polyline points="2 17 12 22 22 17"/>
          <polyline points="2 12 12 17 22 12"/>
        </svg>
        <span data-i18n="characters.collectionLabel">Colección:</span>
      </span>
      <div class="char-filter-group">
        <button
          type="button"
          class="char-universe-tab active"
          data-universe="all"
          role="tab"
          aria-selected="true"
        >
          <span data-i18n="characters.all">Ambas colecciones (18)</span>
        </button>
        <button
          type="button"
          class="char-universe-tab"
          data-universe="lovelys"
          role="tab"
          aria-selected="false"
        >
          <span class="universe-tab-dot lovelys"></span>
          <span>TWICE LOVELYS (9)</span>
        </button>
        <button
          type="button"
          class="char-universe-tab"
          data-universe="tdoongz"
          role="tab"
          aria-selected="false"
        >
          <span class="universe-tab-dot tdoongz"></span>
          <span>TDOONGZ Dream Attic (9)</span>
        </button>
      </div>
    </div>

    <div class="character-intros">
      <!-- ARTÍCULO 1: TWICE LOVELYS -->
      <article class="character-intro lovelys-panel scroll-reveal">
        <div class="character-panel-header">
          <span class="collection-label">La colección original · 9 Lovelys</span>
          <span class="collection-badge lovelys-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>LOVELYS WORLD</span>
          </span>
        </div>
        <h3>TWICE LOVELYS</h3>
        <p>
          Las mascotas oficiales nacidas con el universo de TWICE. Presentes en giras mundiales, Lightsticks (CandyBong), videoclips y peluches coleccionables.
        </p>

        <div class="character-gallery lovelys-gallery" aria-label="Galería de TWICE Lovelys">
          {LOVELYS.map((lovely) => (
            <CharacterTile character={lovely} galleryType="lovely" />
          ))}
        </div>

        <div class="panel-footer-action">
          <a class="button light panel-action-btn" href="https://jypj-store.com/collections/twice-lovelys" target="_blank" rel="noreferrer">
            <span>Ver colección oficial en JYP Store</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>

      <!-- ARTÍCULO 2: TDOONGZ -->
      <article class="character-intro tdoongz tdoongz-panel scroll-reveal">
        <div class="character-panel-header">
          <span class="collection-label">Nuevos personajes · presentados en 2024</span>
          <span class="collection-badge tdoongz-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/>
            </svg>
            <span>DREAM ATTIC</span>
          </span>
        </div>
        <h3>TDOONGZ</h3>
        <p>
          Presentados oficialmente en octubre de 2024. Los tiernos habitantes de "Dream Attic" con personalidades y pasatiempos únicos inspirados directamente en cada integrante.
        </p>

        <div class="character-gallery tdoongz-gallery" aria-label="Galería de personajes TDOONGZ">
          {TDOONGZ.map((tdoong) => (
            <CharacterTile character={tdoong} galleryType="tdoongz" />
          ))}
        </div>

        <div class="panel-footer-action">
          <a class="button light panel-action-btn" href="https://x.com/JYPETWICE" target="_blank" rel="noreferrer">
            <span>Ver anuncio oficial de Dream Attic</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>

    <div class="characters-footer-note">
      <svg class="note-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="16" x2="12" y2="12"/>
        <line x1="12" y1="8" x2="12.01" y2="8"/>
      </svg>
      <p>
        Imágenes oficiales extraídas directamente del catálogo de JYP Online Store (colección Soft Toy TWICE LOVELYS) y de la revelación de TDOONGZ "Dream Attic" de TWICE.
      </p>
    </div>
  </div>
</section>

<script>
  import { initCharactersFilter } from '../scripts/characters-filter';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharactersFilter);
  } else {
    initCharactersFilter();
  }
</script>
