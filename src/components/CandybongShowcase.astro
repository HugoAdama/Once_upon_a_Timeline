---
import { CANDYBONG_MODELS } from '../data/collector-vault';
import { MEMBERS } from '../data/members';
import { resolveAsset } from '../utils/streaming';
---

<div class="candybong-showcase-container" id="candybong-showcase">
  <!-- Columna Izquierda: Simulador de Luz en Concierto -->
  <div class="candybong-stage-card">
    <div class="stage-kicker-row">
      <div class="stage-kicker-group">
        <svg class="kicker-pulse-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
        <span class="stage-kicker">SIMULADOR LUMÍNICO EN VIVO</span>
      </div>
      <span class="stage-status-badge">
        <span class="status-live-dot" aria-hidden="true"></span>
        <span>BLUETOOTH ACTIVO</span>
      </span>
    </div>

    <!-- Escenario Visual del Lightstick -->
    <div class="candybong-light-stage" id="candybong-light-stage" style="--candy-glow-color: #e83e86; --candy-secondary-color: #f4a27e;">
      <!-- Halo de resplandor ambiental -->
      <div class="candybong-glow-aura" aria-hidden="true"></div>

      <!-- Silueta SVG Interactiva del Candybong Z / Infinity -->
      <div class="candybong-interactive-silhouette" aria-hidden="true">
        <!-- Aro del cabezal -->
        <div class="silhouette-head">
          <div class="silhouette-infinity-tunnel">
            <span class="tunnel-ring r1"></span>
            <span class="tunnel-ring r2"></span>
            <span class="tunnel-ring r3"></span>
            <svg class="tunnel-center-sparkle-svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/>
            </svg>
          </div>
          <div class="silhouette-outer-rim"></div>
        </div>
        <!-- Cuello y mango -->
        <div class="silhouette-neck"></div>
        <div class="silhouette-handle">
          <span class="silhouette-button"></span>
          <span class="silhouette-grip-line"></span>
          <span class="silhouette-grip-line"></span>
          <span class="silhouette-brand-text">TWICE</span>
        </div>
        <!-- Reflejo en el suelo del escenario -->
        <div class="silhouette-floor-reflection"></div>
      </div>

      <!-- Nombre del modo de color activo -->
      <div class="stage-color-readout" id="stage-color-readout">
        <span class="readout-dot" id="readout-dot"></span>
        <span class="readout-label" id="readout-label">Neon Magenta · Paleta Oficial</span>
      </div>
    </div>

    <!-- Controles de Color de Integrante -->
    <div class="candybong-color-controls">
      <span class="controls-label">Selecciona el color del concierto:</span>
      <div class="color-bubbles-grid" role="group" aria-label="Colores oficiales de integrantes">
        <button
          type="button"
          class="color-bubble active"
          data-candy-color="#e83e86"
          data-candy-color-sec="#f4a27e"
          data-color-name="Apricot &amp; Magenta · TWICE Oficial"
          title="TWICE Oficial · Apricot &amp; Neon Magenta"
          style="background: linear-gradient(135deg, #e83e86, #f4a27e);"
        >
          <span class="bubble-inner"></span>
        </button>
        {MEMBERS.map((m) => (
          <button
            type="button"
            class="color-bubble"
            data-candy-color={m.colorHex}
            data-candy-color-sec={m.colorHex}
            data-color-name={`${m.name} · ${m.colorName}`}
            title={`${m.name} · ${m.colorName}`}
            style={`--bubble-c: ${m.colorHex}; background: ${m.colorHex};`}
          >
            <span class="bubble-inner"></span>
          </button>
        ))}
      </div>
    </div>

    <!-- Selector de Ritmo Lumínico -->
    <div class="candybong-rhythm-controls">
      <button type="button" class="rhythm-btn active" data-light-mode="steady">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
        <span>Luz Continua</span>
      </button>
      <button type="button" class="rhythm-btn" data-light-mode="pulse">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        <span>Pulso Estadio</span>
      </button>
      <button type="button" class="rhythm-btn" data-light-mode="rave">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        <span>Modo Fiesta</span>
      </button>
    </div>
  </div>

  <!-- Columna Derecha: Cronología y Fichas Técnicas de la Trilogía -->
  <div class="candybong-models-column">
    <div class="models-nav" role="tablist" aria-label="Modelos de Candybong">
      {CANDYBONG_MODELS.map((model, idx) => (
        <button
          type="button"
          class={`model-tab-btn ${idx === 2 ? 'active' : ''}`}
          data-target-model={model.id}
          role="tab"
          aria-selected={idx === 2 ? 'true' : 'false'}
        >
          <span class="tab-version">{model.version}</span>
          <span class="tab-year">{model.releaseYear}</span>
          <span class="tab-name">{model.name}</span>
        </button>
      ))}
    </div>

    <!-- Fichas detalladas para cada modelo -->
    <div class="models-cards-container">
      {CANDYBONG_MODELS.map((model, idx) => (
        <article
          class={`model-detail-card ${idx === 2 ? 'active' : ''}`}
          id={`model-card-${model.id}`}
          data-model-id={model.id}
        >
          <!-- Fila Superior de Identificación -->
          <div class="card-hero-row">
            <div class="model-meta-info">
              <span class="model-era-pill">{model.eraName}</span>
              <h3 class="model-title">{model.name}</h3>
              <span class="model-concept-tag">{model.conceptTag}</span>
            </div>
            <div class="model-year-badge">
              <span>{model.releaseYear}</span>
            </div>
          </div>

          <!-- Escaparate Central Bento: Fotografía Real Oficial + Especificaciones -->
          <div class="model-showcase-split">
            {model.image && (
              <div class="model-real-pedestal" title={`Fotografía oficial de ${model.name}`}>
                <div class="pedestal-halo" aria-hidden="true"></div>
                <img
                  src={resolveAsset(model.image)}
                  alt={`Fotografía oficial del lightstick ${model.name}`}
                  class="model-real-img"
                  loading="lazy"
                  width="140"
                  height="140"
                />
                <span class="pedestal-tag">FOTO OFICIAL JYP</span>
              </div>
            )}

            <div class="model-content-side">
              <p class="model-description">{model.description}</p>

              <!-- Especificaciones Técnicas de Ingeniería -->
              <div class="specs-grid">
                <div class="spec-cell">
                  <span class="spec-label">Tecnología Lumínica</span>
                  <span class="spec-val">{model.lightingSpecs.technology}</span>
                </div>
                <div class="spec-cell">
                  <span class="spec-label">Alimentación</span>
                  <span class="spec-val">{model.lightingSpecs.batteryType}</span>
                </div>
                <div class="spec-cell">
                  <span class="spec-label">Conectividad</span>
                  <span class="spec-val">{model.lightingSpecs.connectivity}</span>
                </div>
                <div class="spec-cell">
                  <span class="spec-label">Modos de Luz</span>
                  <span class="spec-val">{model.lightingSpecs.modes.join(' · ')}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Datos Curiosos & Lore de Conciertos con Iconos SVG -->
          <div class="lore-box">
            <div class="lore-item">
              <span class="lore-icon-svg" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              </span>
              <div class="lore-text">
                <strong>Momento Histórico en Estadios:</strong>
                <span>{model.stadiumLore}</span>
              </div>
            </div>
            <div class="lore-item">
              <span class="lore-icon-svg" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                  <circle cx="12" cy="12" r="4"/>
                </svg>
              </span>
              <div class="lore-text">
                <strong>Curiosidad de Coleccionista:</strong>
                <span>{model.funFact}</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>
