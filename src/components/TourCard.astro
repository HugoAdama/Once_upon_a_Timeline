---
import type { WorldTour } from '../types';
import { resolveAsset } from '../utils/streaming';
import TourPhotoGallery from './TourPhotoGallery.astro';
import TourVenuesGrid from './TourVenuesGrid.astro';

interface Props {
  tour: WorldTour;
  isFirst?: boolean;
}

const { tour, isFirst = false } = Astro.props;

const slidesData = tour.gallery.map((item) => ({
  url: resolveAsset(item.url) || item.url,
  caption: item.caption,
  location: item.location,
}));
---

<div class={`tour-content-panel ${isFirst ? 'tour-panel-active' : ''}`} id={`panel-${tour.id}`} style={isFirst ? '' : 'display: none;'}>
  <div class="tour-main-card">
    <!-- Bento Superior: Galería de Concierto Interactiva (30s) + Metadatos de la Gira -->
    <div class="tour-overview-bento">
      <!-- Showcase Visual con Rotación Automática cada 30 Segundos -->
      <TourPhotoGallery
        tourId={tour.id}
        years={tour.years}
        slidesData={slidesData}
      />

      <!-- Columna Derecha: Identidad, Cifras Clave y Setlist -->
      <div class="tour-meta-column">
        <div class="tour-title-wrap">
          <div class="tour-kicker-bar">
            <span class="tour-kicker" data-i18n="tours.officialTour">Gira Mundial Oficial</span>
            {tour.logo && (
              <div class="tour-logo-badge">
                <img
                  src={resolveAsset(tour.logo)}
                  alt={`Logo oficial de ${tour.name}`}
                  class="tour-logo-img"
                  loading="lazy"
                />
              </div>
            )}
          </div>
          <h3 class="tour-name">{tour.name}</h3>
          <p class="tour-tagline" data-i18n={`tour.${tour.id}.tagline`}>{tour.tagline}</p>
        </div>

        <!-- Métricas Bento -->
        <div class="tour-stats-bento">
          <div class="tour-stat-tile">
            <div class="tour-stat-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/>
              </svg>
            </div>
            <div class="tour-stat-body">
              <span class="tour-stat-num">{tour.totalShows}</span>
              <span class="tour-stat-label" data-i18n="tours.liveShows">Conciertos en Vivo</span>
            </div>
          </div>

          <div class="tour-stat-tile highlight">
            <div class="tour-stat-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="tour-stat-body">
              <span class="tour-stat-num" data-i18n={`tour.${tour.id}.attendance`}>{tour.attendance}</span>
              <span class="tour-stat-label" data-i18n="tours.accumulatedAttendance">Asistencia Acumulada</span>
            </div>
          </div>
        </div>

        <!-- Setlist Highlights Integrado -->
        <div class="tour-setlist-card">
          <div class="tour-setlist-head">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18V5l12-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zm12-2a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="tour-setlist-title"><span data-i18n="tours.setlistTitle">Setlist de la Gira</span> <span class="tour-setlist-count" data-setlist-count={tour.setlistHighlights.length}>({tour.setlistHighlights.length} canciones)</span></span>
          </div>
          <div class="tour-setlist-pills">
            {tour.setlistHighlights.map((song) => {
              const i18nKey = song.includes('MISAMO') ? 'tour.setlist.units_solos' : song.includes('Ruleta') ? 'tour.setlist.encore_wheel' : '';
              return <span class="tour-setlist-pill" data-i18n={i18nKey || undefined}>{song}</span>;
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- Sección Inferior: Estadios y Sedes Históricas con Distribución Equilibrada -->
    <TourVenuesGrid venues={tour.keyVenues} tourId={tour.id} />
  </div>
</div>
