<div class="jukebox-playlist-wrap">
  <div class="jukebox-playlist-header">
    <span class="jukebox-playlist-title">Canciones disponibles</span>
  </div>
  <div class="jukebox-playlist" role="tablist" aria-label="Lista de canciones oficiales">
    <button class="jukebox-track-pill active" type="button" data-track-index="0">
      <span class="pill-num">01</span>
      <span class="pill-name">Feel Special</span>
    </button>
    <button class="jukebox-track-pill" type="button" data-track-index="1">
      <span class="pill-num">02</span>
      <span class="pill-name">What is Love?</span>
    </button>
    <button class="jukebox-track-pill" type="button" data-track-index="2">
      <span class="pill-num">03</span>
      <span class="pill-name">FANCY</span>
    </button>
    <button class="jukebox-track-pill" type="button" data-track-index="3">
      <span class="pill-num">04</span>
      <span class="pill-name">The Feels</span>
    </button>
    <button class="jukebox-track-pill" type="button" data-track-index="4">
      <span class="pill-num">05</span>
      <span class="pill-name">ONE SPARK</span>
    </button>
    <button class="jukebox-track-pill" type="button" data-track-index="5">
      <span class="pill-num">06</span>
      <span class="pill-name">I CAN'T STOP ME</span>
    </button>
  </div>
</div>
