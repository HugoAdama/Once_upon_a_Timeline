---
import type { Release } from '../types';
import { getStreamingLinks, resolveAsset } from '../utils/streaming';

interface Props {
  release: Release;
}

const { release } = Astro.props;
const coverSrc = resolveAsset(release.cover);

// Formateo de fecha en español (ej: "10 oct.", "24 abr.")
const releaseDateObj = new Date(release.date + 'T00:00:00');
const formattedDate = releaseDateObj.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
});

const tracksString = release.tracks.map((t) => t.title).join(' | ');
const trackCount = release.tracks.length;
const trackCountLabel = trackCount === 1 ? '1 canción' : `${trackCount} canciones`;
---

<li
  class="release-item"
  id={release.id}
  data-market={release.market}
  data-year={release.year}
  data-format={release.format}
  data-title={release.title}
  data-tracks={tracksString}
>
  <details class="release-details">
    <summary class="release-summary" aria-label={`${release.title}, lanzado el ${release.date}. ${trackCountLabel}.`}>
      <div class="release-cover-frame" role="img" aria-label={`Portada de ${release.title}`}>
        {coverSrc ? (
          <img
            src={coverSrc}
            alt={`Portada oficial de ${release.title}`}
            loading="lazy"
            decoding="async"
            width="56"
            height="56"
            class="release-cover-img"
            onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='grid';"
          />
        ) : null}
        <div class="release-art-placeholder" style={coverSrc ? 'display: none;' : ''}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
          </svg>
          <small>Portada</small>
        </div>
      </div>

      <div class="release-date-col">
        <time datetime={release.date} data-date={release.date}>{formattedDate}</time>
        <span class="release-year-pill">{release.year}</span>
      </div>

      <div class="release-copy">
        <strong class="release-name">{release.title}</strong>
        <div class="release-meta-row">
          <span class={`release-type-badge format-${release.format}`} data-format-badge={release.format}>{release.formatLabel}</span>
          <span class="release-tracks-badge">
            <svg class="track-icon-svg" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M10 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V6l10-2v7.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V2l-12 2.4z"/>
            </svg>
            <span data-track-count={trackCount}>{trackCountLabel}</span>
          </span>
        </div>
      </div>

      <div class="release-actions-cell">
        <button
          type="button"
          class="release-physical-btn"
          data-physical-release={release.id}
          aria-label={`Marcar ${release.title} en mi colección física`}
          title="Añadir a mi estante físico"
        >
          <svg class="physical-disc-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
        <button
          type="button"
          class="release-fav-btn"
          data-fav-release={release.id}
          aria-label={`Guardar ${release.title} en favoritos`}
          title={`Guardar "${release.title}" en Favoritos`}
        >
          <svg class="fav-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
        </button>
        <span class="release-chevron" aria-hidden="true"></span>
      </div>
    </summary>

    <div class="track-list-panel">
      <div class="track-list-header">
        <span class="track-list-label"><span data-i18n="disco.tracklistOfficial">Tracklist oficial</span> · <span data-track-count={trackCount}>{trackCountLabel}</span></span>
        <span class="streaming-hint" data-i18n="disco.listenPlatforms">Escuchar en plataformas:</span>
      </div>

      <ol class="track-list">
        {release.tracks.map((track, idx) => {
          const links = getStreamingLinks(track.title, release.title);
          const trackNum = String(idx + 1).padStart(2, '0');
          const isLeadSingle = idx === 0 && release.format !== 'compilation' && release.format !== 'remix';
          return (
            <li class={`track-item ${isLeadSingle ? 'is-lead-track' : ''}`}>
              <div class="track-info">
                <span class="track-num" aria-label={`Pista ${idx + 1}`}>{trackNum}</span>
                <span class="track-title">{track.title}</span>
                {isLeadSingle && (
                  <span class="title-track-pill" title="Canción principal / Lead Single de la era" data-i18n-title="disco.leadSingleHint">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    <span>TITLE</span>
                  </span>
                )}
              </div>
              <div class="track-links">
                <a href={links.spotify} target="_blank" rel="noopener noreferrer" class="stream-btn spotify-btn" aria-label={`Escuchar ${track.title} en Spotify`} title={`Escuchar "${track.title}" en Spotify`}>
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.498 17.306c-.216.353-.674.464-1.027.248-2.812-1.718-6.353-2.106-10.523-1.154-.403.092-.806-.16-.898-.562-.092-.403.16-.806.562-.898 4.566-1.043 8.484-.596 11.638 1.339.353.216.464.674.248 1.027zm1.468-3.262c-.272.443-.852.583-1.295.311-3.218-1.977-8.125-2.55-11.93-1.395-.499.151-1.03-.133-1.181-.632-.151-.499.133-1.03.632-1.181 4.352-1.32 9.773-.679 13.463 1.589.443.272.583.852.311 1.295zm.126-3.41c-3.859-2.292-10.228-2.503-13.896-1.389-.591.179-1.218-.163-1.397-.754-.179-.591.163-1.218.754-1.397 4.218-1.281 11.253-1.033 15.696 1.603.532.316.708 1.008.392 1.54-.316.532-1.008.708-1.54.392z"/></svg>
                  <span>Spotify</span>
                </a>
                <a href={links.youtubeMusic} target="_blank" rel="noopener noreferrer" class="stream-btn yt-btn" aria-label={`Escuchar ${track.title} en YouTube Music`} title={`Escuchar "${track.title}" en YouTube Music`}>
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 0C5.376 0 0 5.376 0 12s5.376 12 12 12 12-5.376 12-12S18.624 0 12 0zm0 19c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7zm-2-10.5v7l6-3.5-6-3.5z"/></svg>
                  <span>YT Music</span>
                </a>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </details>
</li>
