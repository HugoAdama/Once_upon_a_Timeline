---
import { resolveAsset } from '../utils/streaming';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const portals = [
  {
    id: 'portal-musica',
    href: `${base}/musica`,
    pill: '250+ Canciones · 14 MVs',
    title: 'Música, Eras & MVs',
    titleKey: 'hub.musicTitle',
    desc: 'Explora la discografía coreana, japonesa y global, busca pistas por álbum y disfruta de los videoclips conceptuales en el Cinema Vault.',
    descKey: 'hub.musicDesc',
    actionText: 'Explorar Discografía & MVs',
    actionKey: 'hub.musicAction',
    image: '/assets/hub/portal-musica.webp',
    iconType: 'music',
  },
  {
    id: 'portal-giras',
    href: `${base}/giras`,
    pill: '5 Giras · 8 Hitos Históricos',
    title: 'Giras & Hall of Fame',
    titleKey: 'hub.toursTitle',
    desc: 'El periplo por estadios masivos como SoFi Stadium y Nissan Stadium, la cumbre THIS IS FOR y el salón de trofeos Daesang y récords globales.',
    descKey: 'hub.toursDesc',
    actionText: 'Explorar Giras & Récords',
    actionKey: 'hub.toursAction',
    image: '/assets/hub/portal-giras.webp',
    iconType: 'globe',
  },
  {
    id: 'portal-fan-zone',
    href: `${base}/fan-zone`,
    pill: 'Test de Afinidad · Photocard',
    title: 'ONCE Fan Zone',
    titleKey: 'hub.fanzoneTitle',
    desc: 'Descubre qué integrante de TWICE comparte tu esencia con el test de afinidad y diseña tu photocard de coleccionista en alta definición.',
    descKey: 'hub.fanzoneDesc',
    actionText: 'Entrar a la Fan Zone',
    actionKey: 'hub.fanzoneAction',
    image: '/assets/hub/portal-fan-zone.webp',
    iconType: 'user',
  },
  {
    id: 'portal-moda',
    href: `${base}/moda`,
    pill: '6 Eras · Alta Costura',
    title: 'Moda Escénica',
    titleKey: 'hub.fashionTitle',
    desc: 'La evolución conceptual del vestuario de TWICE: desde las chaquetas varsity de Cheer Up y el terciopelo de FANCY hasta la opulencia de Feel Special y la alta costura de Strategy.',
    descKey: 'hub.fashionDesc',
    actionText: 'Explorar Moda Escénica',
    actionKey: 'hub.fashionAction',
    image: '/assets/hub/portal-moda.webp',
    iconType: 'shirt',
  },
];
---

<section class="section archive-hub-section" id="portales" aria-labelledby="hub-heading">
  <div class="wrap">
    <div class="section-head scroll-reveal">
      <span class="section-kicker" data-i18n="hub.kicker">03 · PORTALES DEL ARCHIVO</span>
      <h2 id="hub-heading" data-i18n="hub.heading">Capítulos del Archivo de TWICE</h2>
      <p class="section-desc" data-i18n="hub.desc">
        Navega de forma ágil y enfocada por los diferentes universos del legado de TWICE: música completa, hitos globales en estadios, comunidad interactiva y evolución de moda.
      </p>
    </div>

    <!-- Grilla de Portales en 4 Columnas Equilibradas -->
    <div class="archive-hub-grid">
      {portals.map((portal, idx) => (
        <a href={portal.href} class="archive-hub-card scroll-reveal" style={`--hub-idx: ${idx};`}>
          <!-- Showcase Visual del Capítulo -->
          <div class="archive-hub-media">
            <img
              src={resolveAsset(portal.image)}
              alt={portal.title}
              class="archive-hub-img"
              loading="lazy"
            />
            <div class="archive-hub-media-scrim" aria-hidden="true"></div>

            <div class="archive-hub-media-header">
              <span class="archive-hub-pill" data-i18n={`hub.${portal.id}.pill`}>{portal.pill}</span>
              <div class="archive-hub-icon-box" aria-hidden="true">
                {portal.iconType === 'music' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18V5l12-2v13"/>
                    <circle cx="6" cy="18" r="3"/>
                    <circle cx="18" cy="16" r="3"/>
                  </svg>
                )}
                {portal.iconType === 'globe' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                )}
                {portal.iconType === 'user' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                )}
                {portal.iconType === 'shirt' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>
                  </svg>
                )}
              </div>
            </div>
          </div>

          <!-- Cuerpo Informativo del Portal -->
          <div class="archive-hub-body">
            <h3 class="archive-hub-card-title" data-i18n={portal.titleKey}>{portal.title}</h3>
            <p class="archive-hub-card-desc" data-i18n={portal.descKey}>{portal.desc}</p>
            <span class="archive-hub-card-action">
              <span data-i18n={portal.actionKey}>{portal.actionText}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
