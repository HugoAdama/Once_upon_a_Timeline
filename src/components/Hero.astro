---
import { resolveAsset } from '../utils/streaming';
const logoSrc = resolveAsset('/assets/twice-logo.svg');
---

<section class="hero wrap" id="inicio">
  <div class="hero-grid">
    <!-- Columna Izquierda: Tipografía y Contenido Editorial -->
    <div class="hero-copy">
      <!-- Tagline / Issue Header unificado -->
      <div class="hero-issue-strip">
        <span class="issue-pulse-dot" aria-hidden="true"></span>
        <span class="issue-pill">ISSUE NO. 10</span>
        <span class="issue-divider" aria-hidden="true">/</span>
        <span class="issue-era">2015 — 2025 · 10 YEARS</span>
        <span class="issue-badge">ARCHIVO OFICIAL</span>
      </div>

      <h1 class="hero-title">
        Once Upon<br />
        <span class="hero-title-italic">a Timeline.</span>
      </h1>

      <p class="hero-description">
        Una retrospectiva visual y sonora de música, estética y cultura pop. Explora las 9 integrantes de TWICE, una década de discografía legendaria y los dos universos oficiales que acompañan su legado: Lovelys y TDOONGZ.
      </p>

      <div class="hero-actions">
        <a class="hero-btn-primary" href="#integrantes">
          <span>Explorar integrantes</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
        <a class="hero-btn-secondary" href="#discografia">
          <span>Ir a la discografía</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zm12-2a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </a>
      </div>

      <!-- Barra de Métricas y Paleta Editorial Glass Bento -->
      <div class="hero-bento-strip" aria-label="Cifras clave del archivo y paleta oficial">
        <div class="hero-metrics-row">
          <div class="metric-cell">
            <span class="metric-val">9</span>
            <span class="metric-key">Integrantes</span>
          </div>
          <span class="metric-separator" aria-hidden="true"></span>
          <div class="metric-cell">
            <span class="metric-val">10+</span>
            <span class="metric-key">Años</span>
          </div>
          <span class="metric-separator" aria-hidden="true"></span>
          <div class="metric-cell">
            <span class="metric-val">100+</span>
            <span class="metric-key">Obras</span>
          </div>
          <span class="metric-separator" aria-hidden="true"></span>
          <div class="metric-cell">
            <span class="metric-val">18</span>
            <span class="metric-key">Personajes</span>
          </div>
        </div>

        <div class="hero-swatch-strip">
          <div class="swatch-cluster" aria-hidden="true">
            <span class="swatch-bubble swatch-apricot" title="Apricot · #F4A27E"></span>
            <span class="swatch-bubble swatch-magenta" title="Neon Magenta · #E83E86"></span>
          </div>
          <div class="swatch-info">
            <span class="swatch-title">Apricot &amp; Neon Magenta</span>
            <span class="swatch-desc">Paleta oficial representativa de TWICE &amp; ONCE</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Vitrina Editorial Glass Bento & Vinilo Deluxe -->
    <div class="hero-showcase" role="img" aria-label="Vitrina de coleccionista con disco de vinilo y constelación de las 9 integrantes de TWICE">
      <div class="showcase-glass-card">
        <!-- Barra Superior de la Vitrina -->
        <div class="showcase-header">
          <div class="showcase-live-pill">
            <div class="sound-bars" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <span class="live-text">ARCHIVE NO. 10</span>
          </div>
          <span class="showcase-region-pill">KOREA · JAPAN · GLOBAL</span>
        </div>

        <!-- Escenario Central del Vinilo con Órbita Cósmica -->
        <div class="showcase-stage">
          <div class="stage-ambient-aura" aria-hidden="true"></div>

          <!-- Anillos concéntricos sutiles -->
          <div class="stage-orbit-ring inner" aria-hidden="true"></div>
          <div class="stage-orbit-ring outer" aria-hidden="true"></div>

          <!-- Constelación orbital con los 9 colores y tooltips interactivos -->
          <div class="stage-constellation" aria-hidden="true">
            <div class="constellation-node" style="--c: #5bc2e7; --angle: 0deg;" data-member="Nayeon · Sky Blue">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #a9d535; --angle: 40deg;" data-member="Jeongyeon · Lime Green">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #ff6ea7; --angle: 80deg;" data-member="Momo · Pink">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #9e7bb5; --angle: 120deg;" data-member="Sana · Purple">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #f4a27e; --angle: 160deg;" data-member="Jihyo · Apricot">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #75c9be; --angle: 200deg;" data-member="Mina · Mint">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #ffffff; --angle: 240deg;" data-member="Dahyun · White">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #e02438; --angle: 280deg;" data-member="Chaeyoung · Red">
              <span class="node-dot"></span>
            </div>
            <div class="constellation-node" style="--c: #005bac; --angle: 320deg;" data-member="Tzuyu · Navy Blue">
              <span class="node-dot"></span>
            </div>
          </div>

          <!-- Vinilo Deluxe Coleccionista -->
          <div class="deluxe-vinyl" aria-hidden="true">
            <div class="vinyl-sheen-filter"></div>
            <div class="vinyl-groove-layers"></div>
            <div class="vinyl-core-label">
              <span class="vinyl-hole"></span>
              <img src={logoSrc} alt="" class="vinyl-logo-asset" width="56" height="60" />
              <div class="vinyl-label-stamp">33 ⅓ RPM · TWICE</div>
            </div>
          </div>

          <!-- Insignias flotantes de universo de personajes -->
          <div class="stage-tag-badge tag-left" title="9 Lovelys Guardianes">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>9 LOVELYS</span>
          </div>

          <div class="stage-tag-badge tag-right" title="Universo TDOONGZ">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/>
            </svg>
            <span>TDOONGZ</span>
          </div>
        </div>

        <!-- Pie de la Vitrina: Caption Editorial -->
        <div class="showcase-footer">
          <div class="footer-meta-block">
            <span class="footer-subhead">THE SOUNDTRACK OF A DECADE</span>
            <span class="footer-main-quote">9 Voices · 10 Years of History</span>
          </div>
          <div class="footer-edition-tag">
            <span class="edition-line"></span>
            <span class="edition-title">EDICIÓN COLECCIONISTA</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
