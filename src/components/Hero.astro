---
import { resolveAsset } from '../utils/streaming';
import HeroVinylShowcase from './HeroVinylShowcase.astro';

const logoSrc = resolveAsset('/assets/twice-logo.svg') || '/assets/twice-logo.svg';
---

<section class="hero wrap" id="inicio">
  <div class="hero-grid">
    <!-- Columna Izquierda: Tipografía y Contenido Editorial -->
    <div class="hero-copy">
      <!-- Tagline / Issue Header unificado -->
      <div class="hero-issue-strip">
        <span class="issue-pulse-dot" aria-hidden="true"></span>
        <span class="issue-pill">ISSUE NO. 10</span>
        <span class="issue-divider" aria-hidden="true">/</span>
        <span class="issue-era">2015 — 2025 · 10 YEARS</span>
        <span class="issue-badge">ARCHIVO OFICIAL</span>
      </div>

      <h1 class="hero-title">
        Once Upon<br />
        <span class="hero-title-italic">a Timeline.</span>
      </h1>

      <p class="hero-description">
        Una retrospectiva visual y sonora de música, estética y cultura pop. Explora las 9 integrantes de TWICE, una década de discografía legendaria y los dos universos oficiales que acompañan su legado: Lovelys y TDOONGZ.
      </p>

      <div class="hero-actions">
        <a class="hero-btn-primary" href="#integrantes">
          <span>Explorar integrantes</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
        <a class="hero-btn-secondary" href="#discografia">
          <span>Ir a la discografía</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zm12-2a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </a>
      </div>

      <!-- Barra de Métricas y Paleta Editorial Glass Bento -->
      <div class="hero-bento-strip" aria-label="Cifras clave del archivo y paleta oficial">
        <div class="hero-metrics-row">
          <div class="metric-cell">
            <span class="metric-val">9</span>
            <span class="metric-key">Integrantes</span>
          </div>
          <span class="metric-separator" aria-hidden="true"></span>
          <div class="metric-cell">
            <span class="metric-val">10+</span>
            <span class="metric-key">Años</span>
          </div>
          <span class="metric-separator" aria-hidden="true"></span>
          <div class="metric-cell">
            <span class="metric-val">100+</span>
            <span class="metric-key">Obras</span>
          </div>
          <span class="metric-separator" aria-hidden="true"></span>
          <div class="metric-cell">
            <span class="metric-val">18</span>
            <span class="metric-key">Personajes</span>
          </div>
        </div>

        <div class="hero-swatch-strip">
          <div class="swatch-cluster" aria-hidden="true">
            <span class="swatch-bubble swatch-apricot" title="Apricot · #F4A27E"></span>
            <span class="swatch-bubble swatch-magenta" title="Neon Magenta · #E83E86"></span>
          </div>
          <div class="swatch-info">
            <span class="swatch-title">Apricot &amp; Neon Magenta</span>
            <span class="swatch-desc">Paleta oficial representativa de TWICE &amp; ONCE</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Vitrina Editorial Glass Bento & Vinilo Deluxe -->
    <HeroVinylShowcase logoSrc={logoSrc} />
  </div>
</section>
