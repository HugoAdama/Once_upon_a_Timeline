---
import { resolveAsset } from '../utils/streaming';
const logoSrc = resolveAsset('/assets/twice-logo.svg');
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '');

const isActive = (path: string) => {
  if (path === '') {
    return pathname === base || pathname === '';
  }
  return pathname.endsWith(path);
};
---

<header class="site-header" id="site-header">
  <div class="wrap nav">
    <a class="brand" href={`${base}/`} aria-label="Once Upon a Timeline, volver al inicio">
      <span class="brand-seal" aria-hidden="true">
        <img src={logoSrc} alt="" width="26" height="29" class="brand-logo-img" />
      </span>
      <span class="brand-copy">
        Once Upon a Timeline
        <small>TWICE · FAN ARCHIVE</small>
      </span>
    </a>

    <nav class="nav-links" id="main-nav" aria-label="Navegación principal">
      <a href={`${base}/`} class:list={['nav-link', { active: isActive('') }]}>
        <span data-i18n="nav.home">Inicio</span>
      </a>
      <a href={`${base}/musica`} class:list={['nav-link', { active: isActive('/musica') }]}>
        <span data-i18n="nav.music">Música &amp; MVs</span>
      </a>
      <a href={`${base}/giras`} class:list={['nav-link', { active: isActive('/giras') }]}>
        <span data-i18n="nav.tours">Giras &amp; Récords</span>
      </a>
      <a href={`${base}/fan-zone`} class:list={['nav-link', { active: isActive('/fan-zone') }]}>
        <span data-i18n="nav.fanzone">Fan Zone</span>
      </a>
      <a href={`${base}/moda`} class:list={['nav-link', { active: isActive('/moda') }]}>
        <span data-i18n="nav.fashion">Moda</span>
      </a>
    </nav>

    <div class="header-actions">
      <!-- Selector de Idioma (ES / EN / KO / JA) -->
      <div class="lang-selector-wrapper">
        <button class="lang-toggle-btn" id="lang-toggle-btn" type="button" aria-label="Cambiar idioma" aria-expanded="false" aria-haspopup="true" title="Cambiar idioma / Change language">
          <svg class="globe-icon-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span class="current-lang-code" id="current-lang-code">ES</span>
          <svg class="lang-arrow-svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>

        <div class="lang-dropdown-menu" id="lang-dropdown-menu" role="menu" aria-label="Seleccionar idioma">
          <button type="button" class="lang-option-btn active" data-set-lang="es" role="menuitem"><span>Español</span><small>ES</small></button>
          <button type="button" class="lang-option-btn" data-set-lang="en" role="menuitem"><span>English</span><small>EN</small></button>
          <button type="button" class="lang-option-btn" data-set-lang="ko" role="menuitem"><span>한국어</span><small>KO</small></button>
          <button type="button" class="lang-option-btn" data-set-lang="ja" role="menuitem"><span>日本語</span><small>JA</small></button>
        </div>
      </div>

      <!-- Indicador dinámico de sincronización Candybong por integrante -->
      <button class="candybong-sync-badge" id="candybong-sync-badge" type="button" aria-label="Sincronización Candybong por integrante. Clic para cambiar color" title="Candybong Sync: Nayeon (Sky Blue) · Clic para avanzar">
        <span class="candybong-color-dot" id="candybong-color-dot" aria-hidden="true"></span>
        <span class="candybong-member-name" id="candybong-member-name">Nayeon</span>
        <span class="candybong-sync-icon" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
          </svg>
        </span>
      </button>

      <!-- Botón compacto de Modo Concierto / Dark Mode -->
      <button class="theme-toggle-btn" id="theme-toggle-btn" type="button" aria-label="Alternar modo concierto nocturno" title="Modo Concierto (Candybong Night Mode)">
        <span class="theme-icon-box" aria-hidden="true">
          <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
      </button>

      <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="main-nav">
        <span class="menu-bar"></span><span class="menu-bar"></span><span class="menu-bar"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { initNavigation } from '../scripts/navigation';
  import { initThemeToggle } from '../scripts/theme-toggle';
  import { initCandybongSync } from '../scripts/candybong-sync';
  import { initI18n } from '../scripts/i18n';

  function initHeader(): void {
    initI18n();
    initNavigation();
    initThemeToggle();
    initCandybongSync();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
