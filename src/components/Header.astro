---
import { resolveAsset } from '../utils/streaming';
const logoSrc = resolveAsset('/assets/twice-logo.svg');
---

<header class="site-header" id="site-header">
  <div class="wrap nav">
    <a class="brand" href="#inicio" aria-label="Once Upon a Timeline, volver al inicio">
      <span class="brand-seal" aria-hidden="true">
        <img src={logoSrc} alt="" width="26" height="29" class="brand-logo-img" />
      </span>
      <span class="brand-copy">
        Once Upon a Timeline
        <small>TWICE · FAN ARCHIVE</small>
      </span>
    </a>

    <nav class="nav-links" id="main-nav" aria-label="Navegación principal">
      <a href="#integrantes" class="nav-link"><span>Integrantes</span></a>
      <a href="#personajes" class="nav-link"><span>Personajes</span></a>
      <a href="#discografia" class="nav-link"><span>Discografía</span></a>
      <a href="#cronologia" class="nav-link"><span>Cronología</span></a>
    </nav>

    <div class="header-actions">
      <!-- Indicador dinámico de sincronización Candybong por integrante -->
      <button
        class="candybong-sync-badge"
        id="candybong-sync-badge"
        type="button"
        aria-label="Sincronización Candybong por integrante. Clic para cambiar color"
        title="Candybong Sync: Nayeon (Sky Blue) · Clic para avanzar"
      >
        <span class="candybong-color-dot" id="candybong-color-dot" aria-hidden="true"></span>
        <span class="candybong-member-name" id="candybong-member-name">Nayeon</span>
        <span class="candybong-sync-icon" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"/>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
          </svg>
        </span>
      </button>

      <!-- Botón compacto de Modo Concierto / Dark Mode -->
      <button
        class="theme-toggle-btn"
        id="theme-toggle-btn"
        type="button"
        aria-label="Alternar modo concierto nocturno"
        title="Modo Concierto (Candybong Night Mode)"
      >
        <span class="theme-icon-box" aria-hidden="true">
          <!-- Sol (Modo Día) -->
          <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Luna / Candybong (Modo Noche) -->
          <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
      </button>

      <button
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { initNavigation } from '../scripts/navigation';
  import { initThemeToggle } from '../scripts/theme-toggle';
  import { initCandybongSync } from '../scripts/candybong-sync';

  function initHeader(): void {
    initNavigation();
    initThemeToggle();
    initCandybongSync();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
