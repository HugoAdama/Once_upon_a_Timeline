---
import { TIMELINE_MILESTONES } from '../data/timeline';
import { RELEASES } from '../data/releases';
import { resolveAsset } from '../utils/streaming';

const releaseMap = new Map(RELEASES.map((r) => [r.id, r]));
---

<section class="section wrap" id="cronologia">
  <div class="section-heading scroll-reveal">
    <div>
      <span class="eyebrow">04 · Cronología interactiva</span>
      <h2>Un recorrido por momentos clave.</h2>
    </div>
    <p>
      Cada hito histórico conecta directamente con su lanzamiento correspondiente en la discografía. Haz clic en cualquier tarjeta para desplegar sus temas y reproducirlos.
    </p>
  </div>

  <div class="timeline" role="feed" aria-label="Cronología de lanzamientos históricos de TWICE">
    {TIMELINE_MILESTONES.map((item, index) => {
      const stepNum = String(index + 1).padStart(2, '0');
      const release = releaseMap.get(item.releaseId);
      const coverSrc = release ? resolveAsset(release.cover) : null;
      return (
        <article class="timeline-item scroll-reveal">
          <div class="timeline-item-header">
            <div class="timeline-meta-wrap">
              <span class="timeline-step-badge" aria-hidden="true">{stepNum}</span>
              <div class="timeline-date-info">
                <time datetime={item.year} class="timeline-year">{item.year}</time>
                <span class="timeline-badge-pill">{item.badge}</span>
              </div>
            </div>
            {coverSrc && (
              <img
                src={coverSrc}
                alt={`Portada oficial de ${item.title}`}
                class="timeline-cover-thumb"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>

          <h3 class="timeline-title">{item.title}</h3>
          <p class="timeline-desc">{item.description}</p>

          <a
            class="timeline-jump-btn"
            href={`#${item.releaseId}`}
            aria-label={`Ver lanzamiento ${item.title} (${item.year}) y desplegar canciones`}
          >
            <span>Ver canciones y eras</span>
            <span class="jump-arrow" aria-hidden="true">↘</span>
          </a>
        </article>
      );
    })}
  </div>
</section>
