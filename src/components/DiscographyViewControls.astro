---
---

<div class="filter-actions-group">
  <!-- Selector de Modo de Vista (Portadas / Lista Compacta) -->
  <div class="view-switch-group" role="group" aria-label="Cambiar modo de vista de lanzamientos">
    <button
      type="button"
      class="view-switch-btn active"
      id="view-grid-btn"
      data-view-mode="grid"
      aria-pressed="true"
      aria-label="Vista de cuadrícula con portadas"
      title="Vista de cuadrícula"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7"/>
        <rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/>
      </svg>
      <span class="view-switch-label" data-i18n="disco.viewCovers">Portadas</span>
    </button>
    <button
      type="button"
      class="view-switch-btn"
      id="view-compact-btn"
      data-view-mode="compact"
      aria-pressed="false"
      aria-label="Vista compacta de lista"
      title="Vista compacta de lista"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/>
        <line x1="3" y1="12" x2="3.01" y2="12"/>
        <line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      <span class="view-switch-label" data-i18n="disco.viewCompact">Compacta</span>
    </button>
  </div>

  <!-- Control Expandir / Colapsar Todos los Lanzamientos (Solo iconos SVG) -->
  <button
    id="toggle-all-releases-btn"
    class="toggle-all-btn"
    type="button"
    aria-expanded="false"
    aria-label="Expandir o colapsar todos los lanzamientos"
  >
    <svg class="toggle-expand-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
    </svg>
    <svg class="toggle-collapse-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
      <path d="M7 11l5-5 5 5M7 18l5-5 5 5"/>
    </svg>
    <span id="toggle-all-text" data-i18n="disco.expandAll">Expandir todo</span>
  </button>
</div>
