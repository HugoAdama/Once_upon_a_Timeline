---
import type { FashionConcept } from '../types';
import { resolveAsset } from '../utils/streaming';

interface Props {
  concept: FashionConcept;
}

const { concept } = Astro.props;
const imageUrl = resolveAsset(concept.image);
const gallery = concept.gallery && concept.gallery.length > 0 ? concept.gallery : [{ url: concept.image, label: 'Look Principal' }];
---

<article class="fashion-card scroll-reveal" data-fashion-card>
  <div class="fashion-card-media">
    <img
      src={imageUrl}
      alt={`Vestuario conceptual ${concept.title}`}
      class="fashion-card-image"
      loading="lazy"
      data-main-img
    />
    <div class="fashion-media-overlay" aria-hidden="true"></div>
    <div class="fashion-media-header">
      <span class="fashion-era-badge">{concept.era}</span>
      <span class="fashion-year-pill">{concept.year}</span>
    </div>

    <!-- Selector Interactivo de Ángulos / Galería Lookbook -->
    {gallery.length > 1 && (
      <div class="fashion-gallery-bar" role="tablist" aria-label={`Galería de estilos ${concept.era}`}>
        {gallery.map((look, idx) => (
          <button
            type="button"
            class={`fashion-gallery-pill ${idx === 0 ? 'active' : ''}`}
            data-src={resolveAsset(look.url)}
            data-caption-key={idx === 0 ? 'fashion.mainLook' : 'fashion.stageDetail'}
            data-caption={look.label}
            aria-selected={idx === 0 ? 'true' : 'false'}
            role="tab"
          >
            <span data-i18n={idx === 0 ? 'fashion.mainLook' : 'fashion.stageDetail'}>{idx === 0 ? 'Look Principal' : 'Detalle Escénico'}</span>
          </button>
        ))}
      </div>
    )}
  </div>

  <div class="fashion-card-body">
    <h3 class="fashion-title" data-i18n={`fashion.${concept.id}.title`}>{concept.title}</h3>
    <div class="fashion-style-tag" data-i18n={`fashion.${concept.id}.style`}>{concept.style}</div>

    <!-- Indicador de detalle de estilo activo -->
    <div class="fashion-lookbook-indicator" data-caption-target>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <circle cx="8.5" cy="8.5" r="1.5"/>
        <polyline points="21 15 16 10 5 21"/>
      </svg>
      <span class="fashion-indicator-text" data-i18n="fashion.mainLook">{gallery[0]?.label || 'Look Principal'}</span>
    </div>

    <p class="fashion-description" data-i18n={`fashion.${concept.id}.desc`}>{concept.description}</p>

    <div class="fashion-palette-block">
      <span class="fashion-palette-label" data-i18n="fashion.conceptPalette">Paleta Conceptual</span>
      <div class="fashion-swatches">
        {concept.colorPalette.map((color) => (
          <span class="fashion-swatch-dot" style={`background-color: ${color};`} title={color} />
        ))}
      </div>
    </div>

    <div class="fashion-pieces-box">
      <div class="fashion-pieces-title">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span data-i18n="fashion.keyPiecesTitle">Prendas &amp; Siluetas Clave:</span>
      </div>
      <ul class="fashion-pieces-list">
        {concept.keyPieces.map((piece, pIdx) => (
          <li data-i18n={`fashion.${concept.id}.piece.${pIdx}`}>{piece}</li>
        ))}
      </ul>
    </div>

    <div class="fashion-mood-badge">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span data-i18n={`fashion.${concept.id}.mood`}>{concept.conceptMood}</span>
    </div>
  </div>
</article>
