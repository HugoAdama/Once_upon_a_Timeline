---
import { RARE_PHOTOCARDS } from '../data/collector-vault';
import { resolveAsset } from '../utils/streaming';
---

<div class="grail-photocards-container" id="grail-photocards">
  <!-- Barra de Filtros por Rareza -->
  <div class="grail-filter-bar">
    <div class="filter-lead-group">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
      </svg>
      <span class="filter-lead" data-i18n="vault.filterLabel">Filtrar por nivel de rareza:</span>
    </div>
    <div class="grail-filter-chips" role="group" aria-label="Filtro de rareza de photocards">
      <button type="button" class="grail-chip active" data-rarity-filter="all" data-i18n="vault.filterAll">Todas (6)</button>
      <button type="button" class="grail-chip" data-rarity-filter="mythic" data-i18n="vault.filterMythic">Grial Mítico</button>
      <button type="button" class="grail-chip" data-rarity-filter="legendary" data-i18n="vault.filterLegendary">Legendaria</button>
      <button type="button" class="grail-chip" data-rarity-filter="rare" data-i18n="vault.filterRare">Tesoros Raros</button>
    </div>
  </div>

  <!-- Cuadrícula 3D de Photocards Legendarias -->
  <div class="grail-cards-grid">
    {RARE_PHOTOCARDS.map((card) => {
      const photoUrl = resolveAsset(card.sampleFrontPhoto);
      return (
        <div
          class="grail-card-wrapper"
          data-rarity={card.rarity}
          data-card-id={card.id}
          style={`--card-member-color: ${card.memberColor};`}
        >
          <div class="grail-card-3d">
            <!-- Cara Frontal de la Photocard con Efecto Holográfico y Sleeve Protector -->
            <div class="card-face card-front">
              <!-- Destello Holográfico Reactivo al Cursor -->
              <div class={`card-holographic-foil style-${card.holographicStyle}`} aria-hidden="true"></div>

              <!-- Toploader Glass Edge (Bisel de protección coleccionista) -->
              <div class="card-toploader-bevel" aria-hidden="true"></div>

              <div class="card-photo-box">
                <img
                  src={photoUrl}
                  alt={`${card.title} - Photocard oficial de ${card.member}`}
                  class="card-img"
                  loading="lazy"
                  width="270"
                  height="300"
                />
                <div class="card-badges-row">
                  <span class={`rarity-tag tag-${card.rarity}`}>
                    <span class="rarity-dot" aria-hidden="true"></span>
                    <span data-i18n={`photocard.rarity_${card.rarity}`}>{card.rarityBadge}</span>
                  </span>
                  <span class="category-tag" data-i18n={`photocard.cat_${card.category}`}>{card.categoryLabel}</span>
                </div>
              </div>

              <div class="card-meta">
                <div class="card-title-row">
                  <h4 class="card-title" data-i18n={`photocard.${card.id}.title`}>{card.title}</h4>
                  <span class="card-year">{card.year}</span>
                </div>
                <p class="card-subhead" data-i18n={`photocard.${card.id}.era`}>{card.era}</p>

                <div class="card-value-preview">
                  <span class="val-label" data-i18n="vault.marketValue">Valor de Colección:</span>
                  <span class="val-number">{card.marketPriceRange}</span>
                </div>

                <button type="button" class="btn-flip-card" aria-label={`Ver historia y detalles de ${card.title}`}>
                  <span data-i18n="vault.viewLore">Ver historia de coleccionista</span>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Cara Posterior: Archivo Histórico & Datos de Colección -->
            <div class="card-face card-back">
              <div class="back-header">
                <div class="back-seal-group">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                  <span class="back-edition-seal">TWICE ARCHIVE</span>
                </div>
                <span class={`back-rarity-pill tag-${card.rarity}`} data-i18n={`photocard.rarity_${card.rarity}`}>{card.rarityBadge}</span>
              </div>

              <div class="back-body">
                <div class="back-lore-block">
                  <span class="lore-title" data-i18n="vault.cardStoryTitle">Historia de la Carta:</span>
                  <p class="lore-desc" data-i18n={`photocard.${card.id}.lore`}>{card.collectorLore}</p>
                </div>

                <div class="back-stats-grid">
                  <div class="back-stat-cell">
                    <span class="stat-name" data-i18n="vault.statFinish">Acabado Físico</span>
                    <span class="stat-value" data-i18n={`photocard.${card.id}.finish`}>{card.specialFinish}</span>
                  </div>
                  <div class="back-stat-cell">
                    <span class="stat-name" data-i18n="vault.statPrint">Tirada Conocida</span>
                    <span class="stat-value" data-i18n={`photocard.${card.id}.print`}>{card.estimatedRarityUnits}</span>
                  </div>
                  <div class="back-stat-cell full-width">
                    <span class="stat-name" data-i18n="vault.statPrice">Cotización de Mercado</span>
                    <span class="stat-value highlight">{card.marketPriceRange}</span>
                  </div>
                </div>
              </div>

              <button type="button" class="btn-flip-back" aria-label={`Volver al frente de ${card.title}`}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.5 2v6h6M2.66 15.57a10 10 0 1 0 .57-8.38L-2.44 1.52"/>
                </svg>
                <span data-i18n="vault.flipBack">Volver a la photocard</span>
              </button>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
