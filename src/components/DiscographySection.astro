---
import { RELEASES } from '../data/releases';
import { groupReleasesByYear, getUniqueYears } from '../utils/releases';
import DiscographyFilterBar from './DiscographyFilterBar.astro';
import MarketPanel from './MarketPanel.astro';

// Extraer lanzamientos por mercado
const koreaReleases = RELEASES.filter((r) => r.market === 'korea');
const japanReleases = RELEASES.filter((r) => r.market === 'japan');
const globalReleases = RELEASES.filter((r) => r.market === 'global');

// Agrupaciones por año
const koreaByYear = groupReleasesByYear(koreaReleases);
const japanByYear = groupReleasesByYear(japanReleases);
const globalByYear = groupReleasesByYear(globalReleases);

const allYears = getUniqueYears(RELEASES);
---

<section class="section discography" id="discografia">
  <div class="wrap">
    <div class="section-heading scroll-reveal">
      <div>
        <span class="eyebrow">03 · Discografía</span>
        <h2>Cada lanzamiento, una era.</h2>
      </div>
      <p>
        Un archivo interactivo para recorrer los lanzamientos oficiales de TWICE en Corea, Japón y el mercado global.
        Busca álbumes o canciones individuales y filtra por mercado, año o formato.
      </p>
    </div>

    <!-- Barra y controles de filtrado -->
    <DiscographyFilterBar
      totalCount={RELEASES.length}
      koreaCount={koreaReleases.length}
      japanCount={japanReleases.length}
      globalCount={globalReleases.length}
      allYears={allYears}
    />

    <!-- Catálogo de mercados delegados -->
    <div class="release-catalog" id="release-catalog-root">
      <MarketPanel
        marketKey="korea"
        kicker="01 · Mercado"
        title="Corea"
        description="Lanzamientos coreanos publicados bajo el nombre del grupo."
        groups={koreaByYear}
        totalReleases={koreaReleases.length}
        defaultOpen={true}
      />

      <MarketPanel
        marketKey="japan"
        kicker="02 · Mercado"
        title="Japón"
        description="Discografía oficial producida por Warner Music Japan."
        groups={japanByYear}
        totalReleases={japanReleases.length}
      />

      <MarketPanel
        marketKey="global"
        kicker="03 · Mercado"
        title="Global"
        description="Sencillos en inglés, remixes y ediciones internacionales."
        groups={globalByYear}
        totalReleases={globalReleases.length}
      />
    </div>

    <p class="catalog-note">
      Catálogo oficial de lanzamientos grupales de TWICE en Corea, Japón y el mercado global. Incluye álbumes de estudio, mini álbumes (EP), especiales y sencillos digitales. Puedes escuchar cada tema o álbum completo directamente en Spotify y YouTube Music con un solo clic.
    </p>

    <div class="catalog-sources" aria-label="Fuentes oficiales de discografía">
      <a href="https://twice.jype.com/discography" target="_blank" rel="noreferrer">Discografía oficial de Corea ↗</a>
      <a href="https://www.twicejapan.com/discography/" target="_blank" rel="noreferrer">Discografía oficial de Japón ↗</a>
      <a href="https://www.twicejapan.com/news/detail/1379" target="_blank" rel="noreferrer">Lanzamiento digital “Dance Again” ↗</a>
    </div>
  </div>
</section>

<script>
  import { initDiscographyExplorer } from '../scripts/discography-explorer';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiscographyExplorer);
  } else {
    initDiscographyExplorer();
  }
</script>
