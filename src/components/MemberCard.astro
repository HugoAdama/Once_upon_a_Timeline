---
import type { Member } from '../types';
import { resolveAsset } from '../utils/streaming';

interface Props {
  member: Member;
}

const { member } = Astro.props;
const photoSrc = resolveAsset(member.photo || null);
---

<details class="member-card scroll-reveal" style={`--member: ${member.colorHex};`} id={member.id} data-member-id={member.id}>
  <summary aria-label={`Ver perfil y detalles de ${member.name}`}>
    <!-- Marco fotográfico de estilo Photocard de colección con giro 3D interactivo -->
    <div class="photocard-3d-wrap" data-photocard-wrap>
      <figure class="member-photo-frame photocard-front" role="img" aria-label={`Retrato oficial de ${member.name}`}>
        {photoSrc && (
          <img
            src={photoSrc}
            alt={`Retrato oficial de ${member.name}`}
            loading="lazy"
            decoding="async"
            width="540"
            height="660"
            class="member-actual-photo"
            data-photo-current={resolveAsset(member.eras?.current || member.photo)}
            data-photo-between={resolveAsset(member.eras?.between || member.photo)}
            data-photo-classic={resolveAsset(member.eras?.classic || member.photo)}
            onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='grid';"
          />
        )}
        <span class="member-era-indicator" data-member-era-badge aria-label="Era de la fotografía">
          Era Actual
        </span>
        <button
          type="button"
          class="photocard-flip-btn"
          data-photocard-flip
          aria-label={`Girar photocard de ${member.name}`}
          title="Ver reverso coleccionable"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
          </svg>
          <span>Girar</span>
        </button>
        <div class="image-placeholder member-photo" style={photoSrc ? 'display: none;' : ''}>
          <span class="placeholder-copy">
            <b aria-hidden="true">＋</b>
            <small>Retrato de {member.name}</small>
          </span>
        </div>
        <!-- Brillo holográfico de colección -->
        <span class="photocard-shimmer" aria-hidden="true"></span>
      </figure>

      <!-- Reverso coleccionable de la Photocard -->
      <div class="photocard-back" aria-hidden="true">
        <div class="photocard-back-inner">
          <span class="photocard-back-tag">TWICE 10TH ANNIVERSARY</span>
          <div class="photocard-back-seal">
            <span class="back-number">{member.number}</span>
            <span class="back-hangul">{member.hangul}</span>
          </div>
          <div class="photocard-back-signature">
            <strong class="signature-name">{member.name}</strong>
            <small class="signature-role">{member.role}</small>
          </div>
          <p class="photocard-back-quote">
            "{member.lovely.name} &amp; {member.tdoongz.name} con ONCE para siempre"
          </p>
          <div class="photocard-back-footer">
            <span class="collector-code">COLLECTOR CARD · NO. {member.number}</span>
            <button
              type="button"
              class="photocard-flip-btn return-btn"
              data-photocard-flip-back
              aria-label="Volver al frente"
            >
              <span>Volver</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="member-head">
      <div class="member-top-row">
        <div class="member-id-row">
          <span class="member-number">{member.number} · MEMBER</span>
          <span class="member-hangul-sub">{member.hangul}</span>
        </div>
        <span class="member-expand-hint" aria-hidden="true">Ficha</span>
      </div>

      <h3 class="member-title">{member.name}</h3>

      <div class="member-color-row">
        <span class="member-color-tag">
          <i aria-hidden="true" style={`background-color: ${member.colorHex};`}></i>
          <span>{member.colorName}</span>
        </span>
        <button
          type="button"
          class="member-bias-btn"
          data-set-bias={member.id}
          aria-label={`Elegir a ${member.name} como Bias y tematizar el sitio con su color`}
          title={`Elegir a ${member.name} como tu Bias`}
        >
          <svg class="bias-star-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <span class="bias-btn-label">Mi Bias</span>
        </button>
        {member.instagram && (
          <a
            href={member.instagram.url}
            target="_blank"
            rel="noreferrer noopener"
            class="member-ig-badge"
            aria-label={`Instagram oficial de ${member.name}: ${member.instagram.handle}`}
            title={`Abrir perfil oficial de Instagram de ${member.name}`}
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <span>{member.instagram.handle}</span>
          </a>
        )}
      </div>
    </div>

    <!-- Pareja de personajes Lovely & Tdoongz -->
    <div class="char-pair">
      <div class="char-chip lovely-chip" title={`Lovely de ${member.name}: ${member.lovely.name}`}>
        {member.lovely.avatar ? (
          <img
            src={resolveAsset(member.lovely.avatar)}
            alt=""
            class="char-chip-avatar"
            width="28"
            height="28"
            loading="lazy"
          />
        ) : (
          <span class="char-symbol" aria-hidden="true">♡</span>
        )}
        <div class="char-info">
          <small>LOVELY</small>
          <strong>{member.lovely.name}</strong>
        </div>
      </div>
      <div class="char-chip tdoongz-chip" title={`TDOONGZ de ${member.name}: ${member.tdoongz.name}`}>
        {member.tdoongz.avatar ? (
          <img
            src={resolveAsset(member.tdoongz.avatar)}
            alt=""
            class="char-chip-avatar"
            width="28"
            height="28"
            loading="lazy"
          />
        ) : (
          <span class="char-symbol" aria-hidden="true">✦</span>
        )}
        <div class="char-info">
          <small>TDOONGZ</small>
          <strong>{member.tdoongz.name}</strong>
        </div>
      </div>
    </div>
  </summary>

  <!-- Panel desplegable con ficha biográfica y atributos -->
  <div class="member-details-drawer">
    <div class="member-meta-grid">
      <div class="member-meta-item">
        <small>Nombre completo</small>
        <strong>{member.fullName} ({member.hangul})</strong>
      </div>
      <div class="member-meta-item">
        <small>Nacimiento</small>
        <strong>{member.birthdate}</strong>
      </div>
      {member.instagram && (
        <div class="member-meta-item">
          <small>Instagram Oficial</small>
          <strong>
            <a href={member.instagram.url} target="_blank" rel="noreferrer noopener" class="meta-social-link">
              <span>{member.instagram.handle}</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </a>
          </strong>
        </div>
      )}
      <div class="member-meta-item full-width">
        <small>Posición y rol en TWICE</small>
        <strong>{member.role}</strong>
      </div>
    </div>

    <p class="member-bio">{member.bio}</p>

    <div class="character-bio-cards">
      <div class="char-bio-item lovely-bio">
        <span class="char-bio-badge">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>LOVELY</span>
        </span>
        <p><strong>{member.lovely.name}:</strong> {member.lovely.description}</p>
      </div>
      <div class="char-bio-item tdoongz-bio">
        <span class="char-bio-badge">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/>
          </svg>
          <span>TDOONGZ</span>
        </span>
        <p><strong>{member.tdoongz.name}:</strong> {member.tdoongz.description}</p>
      </div>
    </div>
  </div>
</details>
