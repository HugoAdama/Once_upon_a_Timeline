---
import { FORMAT_OPTIONS } from '../utils/releases';
import DiscographyQuickEras from './DiscographyQuickEras.astro';
import DiscographyKillingParts from './DiscographyKillingParts.astro';
import DiscographyViewControls from './DiscographyViewControls.astro';

interface Props {
  totalCount: number;
  koreaCount: number;
  japanCount: number;
  globalCount: number;
  allYears: number[];
}

const { totalCount, koreaCount, japanCount, globalCount, allYears } = Astro.props;
---

<div class="filter-bar scroll-reveal" role="search" aria-label="Explorador y buscador de discografía">
  <!-- Fila 1: Buscador Principal y Limpiar Filtros -->
  <div class="filter-search-row">
    <div class="search-input-wrap">
      <span class="search-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Busca un álbum o canción… (ej. Kura Kura, Feel Special, TT, Strategy)"
        aria-label="Busca un álbum o canción"
        autocomplete="off"
        data-i18n-placeholder="disco.searchPlaceholder"
      />
      <div class="search-badges" aria-hidden="true">
        <span class="search-kbd-hint" title="Presiona '/' para buscar">/</span>
      </div>
    </div>
    <button id="clear-filters-btn" class="clear-btn" type="button" aria-label="Limpiar todos los filtros y búsqueda">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
      </svg>
      <span data-i18n="disco.clearFilters">Limpiar filtros</span>
    </button>
  </div>

  <!-- Fila 2: Pestañas de Atajos Rápidos (Eras Destacadas / Killing Parts) -->
  <div class="discovery-shortcuts-deck" aria-label="Atajos de descubrimiento rápido">
    <div class="discovery-tabs-header">
      <div class="discovery-tab-list" role="tablist" aria-label="Categorías de atajos rápidos">
        <button
          type="button"
          role="tab"
          id="tab-quick-eras"
          aria-selected="true"
          aria-controls="panel-quick-eras"
          class="discovery-tab-btn active"
        >
          <svg class="tab-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span data-i18n="disco.quickErasTab">Eras Destacadas</span>
          <span class="tab-badge">7</span>
        </button>

        <button
          type="button"
          role="tab"
          id="tab-killing-parts"
          aria-selected="false"
          aria-controls="panel-killing-parts"
          class="discovery-tab-btn"
        >
          <svg class="tab-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
          <span data-i18n="disco.killingPartsTab">Killing Parts & Frases</span>
          <span class="tab-badge">8</span>
        </button>
      </div>
      <span class="discovery-hint" data-i18n="disco.quickHint">Haz clic en una era o frase para filtrar al instante</span>
    </div>

    <div class="discovery-tab-panels">
      <div
        id="panel-quick-eras"
        role="tabpanel"
        aria-labelledby="tab-quick-eras"
        class="discovery-tab-panel active"
      >
        <DiscographyQuickEras />
      </div>

      <div
        id="panel-killing-parts"
        role="tabpanel"
        aria-labelledby="tab-killing-parts"
        class="discovery-tab-panel"
        hidden
      >
        <DiscographyKillingParts />
      </div>
    </div>
  </div>

  <!-- Fila 3: Rejilla Balanceada de Filtros (2 Columnas: Mercado | Año y Formato) -->
  <div class="filter-controls-row">
    <!-- Columna Izquierda: Filtros de mercado con iconos SVG -->
    <div class="filter-controls-markets">
      <span class="filter-label" id="label-market" data-i18n="disco.marketLabel">Mercado:</span>
      <div class="filter-chips" role="radiogroup" aria-labelledby="label-market">
        <button type="button" class="chip-btn active" data-filter-market="all" role="radio" aria-checked="true">
          <span data-i18n="disco.marketAll">Todos</span>
        </button>

        <button type="button" class="chip-btn" data-filter-market="korea" role="radio" aria-checked="false">
          <svg class="market-svg-icon" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <rect width="16" height="12" rx="2" fill="#ffffff" stroke="#e0d5db" stroke-width="0.75"/>
            <circle cx="8" cy="6" r="3" fill="#cd2e3a"/>
            <path d="M5 6a3 3 0 0 0 6 0c0 1.657-1.343 3-3 3A3 3 0 0 1 5 6z" fill="#0047a0"/>
          </svg>
          <span data-i18n="disco.marketKorea">Corea</span>
          <span class="chip-count">({koreaCount})</span>
        </button>

        <button type="button" class="chip-btn" data-filter-market="japan" role="radio" aria-checked="false">
          <svg class="market-svg-icon" width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
            <rect width="16" height="12" rx="2" fill="#ffffff" stroke="#e0d5db" stroke-width="0.75"/>
            <circle cx="8" cy="6" r="3" fill="#bc002d"/>
          </svg>
          <span data-i18n="disco.marketJapan">Japón</span>
          <span class="chip-count">({japanCount})</span>
        </button>

        <button type="button" class="chip-btn" data-filter-market="global" role="radio" aria-checked="false">
          <svg class="market-svg-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="21" y1="12" x2="3" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span data-i18n="disco.marketGlobal">Global</span>
          <span class="chip-count">({globalCount})</span>
        </button>

        <button
          type="button"
          class="chip-btn fav-filter-btn"
          id="filter-fav-btn"
          data-filter-fav="false"
          role="button"
          aria-pressed="false"
          title="Ver lanzamientos guardados en favoritos"
        >
          <svg class="fav-filter-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
          <span data-i18n="disco.myFavorites">Mis Favoritos</span>
          <span class="chip-count" id="favs-counter">(0)</span>
        </button>
      </div>
    </div>

    <!-- Columna Derecha: Selectores combinados (Año y Formato) -->
    <div class="filter-controls-dropdowns">
      <div class="filter-select-field">
        <label for="filter-year" class="filter-label" data-i18n="disco.yearLabel">Año:</label>
        <div class="select-wrapper">
          <select id="filter-year" class="filter-select" aria-label="Filtrar por año de lanzamiento">
            <option value="all" data-i18n="disco.allYears">Todos los años</option>
            {allYears.map((yr) => (
              <option value={yr}>{yr}</option>
            ))}
          </select>
          <svg class="select-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>

      <div class="filter-select-field">
        <label for="filter-format" class="filter-label" data-i18n="disco.formatLabel">Formato:</label>
        <div class="select-wrapper">
          <select id="filter-format" class="filter-select" aria-label="Filtrar por formato de lanzamiento">
            {FORMAT_OPTIONS.map((opt) => (
              <option value={opt.value} data-i18n={`disco.format_${opt.value}`}>{opt.label}</option>
            ))}
          </select>
          <svg class="select-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Fila 4: Barra de Estado y Acciones de Vista -->
  <div class="filter-status-row">
    <div class="filter-status-info">
      <span id="results-counter" class="results-counter" aria-live="polite" data-total-count={totalCount}>
        Mostrando {totalCount} lanzamientos
      </span>
      <span class="filter-tip" data-i18n="disco.searchTip">Tip: presiona / para buscar en cualquier momento.</span>
    </div>

    <!-- Controles de Vista y Colapso -->
    <DiscographyViewControls />
  </div>
</div>

<!-- MENSAJE DE COINCIDENCIAS NO ENCONTRADAS -->
<div id="no-results-msg" class="no-results-msg" role="status" aria-live="polite">
  <h4 data-i18n="disco.noMatchesTitle">No se encontraron coincidencias</h4>
  <p data-i18n="disco.noMatchesDesc">No hay lanzamientos ni canciones que coincidan con los filtros y término de búsqueda actuales.</p>
  <button class="button small" id="reset-empty-btn" type="button" data-i18n="disco.resetEmpty">Restablecer filtros</button>
</div>
